# MySQL 드라이버 모듈 추가
module add --name=com.mysql \
           --resources=/opt/jboss/wildfly/standalone/deployments/mysql-connector-j-9.5.0.jar \
           --dependencies=javax.api,javax.transaction.api

# 데이터소스 등록 (환경변수 사용)
data-source add \
    --name=MySqlDS \
    --driver-name=mysql \
    --connection-url=jdbc:mysql://${env.MYSQL_HOST}:${env.MYSQL_PORT}/${env.MYSQL_DATABASE} \
    --user-name=${env.MYSQL_USER} \
    --password=${env.MYSQL_PASSWORD} \
    --jndi-name=java:java:jboss/datasources/MySqlDS
